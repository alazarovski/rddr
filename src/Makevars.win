TARGET = x86_64-pc-windows-gnu
TARGET_DIR = rust/target
STATLIB = $(TARGET_DIR)/$(TARGET)/release/libairspaceprofile.a
PKG_LIBS = "$(STATLIB)" -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll

all: $(SHLIB)

$(SHLIB): $(STATLIB)

.PHONY: $(STATLIB)
$(STATLIB):
	cargo build --locked --release --features r-api --target=$(TARGET) --manifest-path=rust/Cargo.toml --target-dir="$(TARGET_DIR)"

clean:
	rm -f $(OBJECTS) $(SHLIB)
